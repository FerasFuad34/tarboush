# طربوش - إعدادات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم

# === عام ===
APP_NAME=طربوش
APP_ENV=development
SECRET_KEY=change-this-to-random-64-char
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# === قاعدة البيانات ===
DATABASE_URL=sqlite:///./storage/tarboush.db
# للترقية لاحقاً: postgresql://user:pass@postgres:5432/tarboush

# === Redis & Queue ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# === التخزين ===
STORAGE_PATH=./storage/uploads
EXPORT_PATH=./storage/exports
# 0 = بلا سقف (الحجم يتبع المحاضرة نفسها، والحدّ الوحيد هو مساحة القرص)
MAX_UPLOAD_SIZE_MB=0
ALLOWED_MIME_TYPES=audio/mpeg,audio/wav,audio/mp4,video/mp4,application/pdf,application/vnd.openxmlformats-officedocument, text/plain

# === مزود التفريغ STT ===
# local_whisper = faster-whisper محلي مجاني (افتراضي)
# groq = Groq Whisper API (طبقة مجانية سريعة)
STT_PROVIDER=local_whisper
STT_MODEL=medium
# مكان تخزين نماذج Whisper (المجلد داخل الحاوية)
WHISPER_MODEL_DIR=./storage/models
# للـ Groq: احصل على المفتاح من https://console.groq.com/keys
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# === مزود الذكاء التوليدي LLM ===
# ollama = محلي مجاني (افتراضي) - حمّل من https://ollama.com
# groq / openai / gemini = سحابي
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
# مفاتيح سحابية (اختيارية)
OPENAI_API_KEY=
GROQ_LLM_API_KEY=
GEMINI_API_KEY=

# === Embeddings ===
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# === الأمان ===
JWT_SECRET=change-jwt-secret
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# === المعالجة ===
FFMPEG_PATH=ffmpeg
WHISPER_BEAM_SIZE=5
WHISPER_LANGUAGE=ar
ENABLE_DEDUPLICATION=true

# === التصدير ===
# الخطوط مضمّنة في backend/fonts (Noto Naskh Arabic — رخصة OFL)
PDF_FONT_PATH=./backend/fonts/NotoNaskhArabic-Regular.ttf

# === مصادر الشرح الخارجية (يوتيوب/ويكيبيديا/ويكي الجامعة/ويكي الكتب/arXiv) ===
# كلها واجهات مجانية بلا مفاتيح. عطّل الكل بـ RESOURCES_ENABLED=false إن أردت العمل دون إنترنت.
RESOURCES_ENABLED=true
RESOURCE_PROVIDERS=youtube,wikipedia,wikiversity,wikibooks,arxiv
YOUTUBE_RESULTS_PER_TOPIC=3
WIKI_RESULTS_PER_TOPIC=2
RESOURCE_SEARCH_TIMEOUT=15

# === تقسيم المحاضرات الطويلة للتفريغ ===
# كل 900 ثانية (15 دقيقة) تُفرَّغ كقطعة ثم تُدمج — يمنع نفاد الذاكرة في المحاضرات الطويلة
AUDIO_CHUNK_SECONDS=900
ENABLE_DENOISE=true
